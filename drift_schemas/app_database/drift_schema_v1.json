  "fixed_sql": [
    {
      "name": "roadmaps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"roadmaps\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "roadmap_sections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"roadmap_sections\" (\"id\" TEXT NOT NULL, \"roadmap_id\" TEXT NOT NULL REFERENCES roadmaps (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "topics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"topics\" (\"id\" TEXT NOT NULL, \"roadmap_id\" TEXT NOT NULL REFERENCES roadmaps (id) ON DELETE CASCADE, \"section_id\" TEXT NOT NULL REFERENCES roadmap_sections (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"objectives\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"estimated_minutes\" INTEGER NOT NULL CHECK(\"estimated_minutes\" > 0), \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "resources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"resources\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"estimated_minutes\" INTEGER NOT NULL CHECK(\"estimated_minutes\" > 0), \"topic_id\" TEXT NULL REFERENCES topics (id) ON DELETE SET NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "challenges",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"challenges\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"prompt\" TEXT NOT NULL, \"hints\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "topic_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"topic_progress\" (\"topic_id\" TEXT NOT NULL REFERENCES topics (id) ON DELETE CASCADE, \"completed_on\" INTEGER NOT NULL, \"completed_at\" TEXT NOT NULL, PRIMARY KEY (\"topic_id\"));"
        }
      ]
    },
    {
      "name": "topic_bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"topic_bookmarks\" (\"topic_id\" TEXT NOT NULL REFERENCES topics (id) ON DELETE CASCADE, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"topic_id\"));"
        }
      ]
    },
    {
      "name": "resource_bookmarks",
